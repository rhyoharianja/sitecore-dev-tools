{
  "manifest_version": 3,
  "name": "Sitecore Dev Tools",
  "version": "1.2.0",
  "description": "Sitecore Scriban editor: syntax highlighting, themes, autocomplete, indent guide, modal editor",

  "permissions": ["storage", "tabs", "activeTab"],

  "host_permissions": [
    "*://*/sitecore/*",
    "*://*.local/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*/sitecore/*",
        "*://*.local/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Sitecore Dev Tools",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "web_accessible_resources": [{
    "resources": ["ce-page.js", "ee-ribbon.js", "ce-media-usage.js"],
    "matches": ["<all_urls>"]
  }]
}
